"research.reason.buds3Pro.spatialAudio" = "Uses Apple native stereo spatialization and earbud head sensor data. Timbre and output latency differ from Samsung 360 Audio; listening validation remains incomplete and the feature is off by default.";
"research.reason.buds3Pro.fullDiagnostics" = "Provides firmware self-test results. Undocumented flags may indicate an unavailable check and require individual interpretation.";
"research.reason.buds3Pro.firmwareUpdate" = "Validates the firmware model, build and segment CRC, transfers data in response to the earbuds, then reads back the build after restart to confirm installation. Charging-case updates are not provided.";
"research.reason.buds3Pro.advancedAudio" = "Samsung UHQ and super-wideband voice need compatible Galaxy codecs and system services unavailable through public macOS interfaces.";
"research.reason.buds3Pro.deviceAutoSwitch" = "Samsung account auto-switch needs mobile/Galaxy system services. The Mac seamless connection switch only configures earbud connection behavior.";
"research.reason.buds3Pro.notificationReading" = "Public macOS notification APIs manage this app’s notifications, without a general interface for reading other apps’ notifications.";
"research.reason.buds3Pro.auracast" = "Public macOS Bluetooth APIs do not provide the complete broadcast audio discovery/join interfaces this app needs; an earbud capability identifier does not supply host support.";
"research.reason.buds3Pro.postureReminder" = "Samsung reminders need mobile calibration and posture services. This app does not supply phone posture data or invent a health assessment algorithm.";
"research.reason.buds3Pro.voiceLanguageDownload" = "Models are bundled with the Samsung mobile plugin. Neither reference project provides an independent model source and complete installer. Installed-version confirmation and recovery lack Mac device evidence; voice commands use the model already in the earbuds.";
"research.reason.buds3Pro.adaptSound" = "Only hearing-profile status fields are confirmed. Complete coefficient formats, test-volume calibration and safe write specifications are missing; this app does not generate unvalidated hearing profiles.";
"research.reason.buds4Pro.spatialAudio" = "Continuous Mac audio and correct head-tracking directions were verified on Buds4 Pro. Native Apple stereo spatialization has a different timbre and output latency from Samsung 360 Audio.";
"research.reason.buds4Pro.fullDiagnostics" = "Provides firmware self-test results. Undocumented flags may indicate an unavailable check and require individual interpretation.";
"research.reason.buds4Pro.firmwareUpdate" = "Image, model, segment CRC, transfer and restart confirmation are implemented. Actual flashing requires explicit confirmation of newer firmware.";
"research.reason.buds4Pro.advancedAudio" = "Samsung UHQ and super-wideband voice need compatible Galaxy codecs and system services unavailable through public macOS interfaces.";
"research.reason.buds4Pro.deviceAutoSwitch" = "Samsung account auto-switch needs mobile/Galaxy system services. The Mac seamless connection switch only configures earbud connection behavior.";
"research.reason.buds4Pro.notificationReading" = "Public macOS notification APIs manage this app’s notifications, without a general interface for reading other apps’ notifications.";
"research.reason.buds4Pro.headCallIntegration" = "Mac lacks a general public interface for controlling other apps’ calls and Bixby; gesture settings and events remain available.";
"research.reason.buds4Pro.auracast" = "Public macOS Bluetooth APIs do not provide the complete broadcast audio discovery/join interfaces this app needs; an earbud capability identifier does not supply host support.";
"research.reason.buds4Pro.postureReminder" = "Samsung reminders need mobile calibration and posture services. This app does not supply phone posture data or invent a health assessment algorithm.";
"research.reason.buds4Pro.voiceLanguageDownload" = "Models are bundled with the Samsung mobile plugin. Neither reference project provides an independent model source and complete installer. Installed-version confirmation and recovery lack Mac device evidence; voice commands use the model already in the earbuds.";
"research.reason.buds4Pro.adaptSound" = "Only hearing-profile status fields are confirmed. Complete coefficient formats, test-volume calibration and safe write specifications are missing; this app does not generate unvalidated hearing profiles.";
